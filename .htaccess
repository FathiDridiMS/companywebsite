# Consultim-IT static site on OVH shared hosting (Apache)
# Place this file in the web root (the "www" folder) next to index.html.

# ---------------------------------------------------------------
# Basics
# ---------------------------------------------------------------
DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

# ---------------------------------------------------------------
# HTTPS and one canonical host: https://consultim-it.com (no www)
# Turn on the free SSL certificate for the domain in the OVH
# control panel BEFORE enabling these rules, or the site will loop.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://consultim-it.com%{REQUEST_URI} [R=301,L]

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.consultim-it\.com$ [NC]
  RewriteRule ^ https://consultim-it.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------
# Keep development files and folders out of reach
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^(partners|\.git)(/|$) - [R=404,L]
</IfModule>
<FilesMatch "(^\.|\.(md|log|bak|sql|ini|sh|ps1|cjs|py)$|^(README|TODO-NOTES)\.md$)">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# Security headers (no CSP: the contact form endpoint is not final yet)
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # HSTS: tells browsers to use https only. Uncomment once https works everywhere.
  # Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# ---------------------------------------------------------------
# Compression
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# Browser caching
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/plain                "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType text/javascript           "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
